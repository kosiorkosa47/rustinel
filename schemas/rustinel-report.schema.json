{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kosiorkosa47/rustinel/main/schemas/rustinel-report.schema.json",
  "title": "rustinel report",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "analysis",
    "project",
    "policy",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "check",
            "diff",
            "explain"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "offline": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "score",
        "level"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "diff": {
      "type": "object",
      "properties": {
        "base_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "head_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "delta": {
          "type": "integer"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "review_required"
          ]
        },
        "violations": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "package",
          "severity",
          "weight",
          "confidence",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "weight": {
            "type": "integer"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    }
  }
}